From 246a15164c2cb572a3aa8a66cb52d66fbe0b35c0 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 8 Apr 2026 18:55:11 +0200
Subject: [PATCH] freedreno/a2xx: force SQ_INTERPOLATOR_CNTL on every draw

Write SQ_INTERPOLATOR_CNTL=0xffffffff unconditionally on every draw
call for A22X. This is a diagnostic workaround for random faceted
rendering issues where smooth shading randomly switches to flat
shading mid-run.

The fd2_program_emit() function already writes this register, but
only when dirty flags (FD_DIRTY_PROG | FD_DIRTY_VTXSTATE |
FD_DIRTY_TEXSTATE) are set. For subsequent draws with the same
shader, the register isn't re-written. If something corrupts the
register between draws, the corruption persists.

This unconditional write ensures correct interpolation state on
every draw until the root cause of the corruption is identified.

Co-Authored-By: Claude Opus 4.5 <noreply@anthropic.com>
---
 src/gallium/drivers/freedreno/a2xx/fd2_emit.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_emit.c b/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
index 40257b1011d..db3bb2e3a18 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
@@ -354,6 +354,21 @@ fd2_emit_state(struct fd_context *ctx, const enum fd_dirty_3d_state dirty)
    if (dirty & (FD_DIRTY_PROG | FD_DIRTY_VTXSTATE | FD_DIRTY_TEXSTATE))
       fd2_program_emit(ctx, ring, &ctx->prog);
 
+   /* A22X: Always write SQ_INTERPOLATOR_CNTL to ensure smooth interpolation.
+    * This is a workaround for random faceted rendering issues where the
+    * register appears to get corrupted between draws. Even though
+    * fd2_program_emit writes this register, it's only called when dirty
+    * flags are set. This unconditional write ensures correct state on
+    * every draw.
+    *
+    * TODO: Find the root cause of the corruption and remove this workaround.
+    */
+   if (is_a22x(ctx->screen)) {
+      OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+      OUT_RING(ring, CP_REG(REG_A2XX_SQ_INTERPOLATOR_CNTL));
+      OUT_RING(ring, 0xffffffff);
+   }
+
    if (dirty & (FD_DIRTY_PROG | FD_DIRTY_CONST)) {
       emit_constants(ring, VS_CONST_BASE * 4,
                      &ctx->constbuf[MESA_SHADER_VERTEX],
